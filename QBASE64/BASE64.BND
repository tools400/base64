STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('BASE64R4 V1.00  ')
   EXPORT symbol('base64_encode')
   EXPORT symbol('base64_decode')
   EXPORT symbol('base64_encodeBufferToStream')
   EXPORT symbol('base64_encodeStreamToStream')
   EXPORT symbol('base64_decodeBufferToStream')
   EXPORT symbol('base64_decodeStreamToStream')
